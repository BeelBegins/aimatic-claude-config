{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/guard_production_command.py\"",
            "timeout": 5,
            "statusMessage": "Checking production and release gates"
          }
        ]
      }
    ]
  }
}
